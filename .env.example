# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Upstash Redis (added via the Vercel marketplace; Vercel sets these in the project)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional daily cap overrides (defaults live in engine/caps.py)
CAP_CHECKS_PER_DAY=
CAP_SEARCHES_PER_DAY=
CAP_DAILY_USD=
# Tester keys: short hashes of tester keys (api/_auth.short_hash), comma-separated, and their limits
TESTER_KEYS=
CAP_TESTER_CHECKS_PER_DAY=
CAP_TESTER_SEARCHES_PER_DAY=
